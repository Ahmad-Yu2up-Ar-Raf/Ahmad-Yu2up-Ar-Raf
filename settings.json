{
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true,
  },

  // Bagian Laravel Blade (Pake Laravel Blade Formatter yang udah lo install)
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": true,
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "php.validate.executablePath": "C:/xampp/php/php.exe",
  "workbench.colorCustomizations": {},
  "workbench.colorTheme": "Vesper",
  "workbench.iconTheme": "symbols",
  "window.commandCenter": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": {
        "id": "terminal-cmd",
      },
    },
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"],
    },
  },
  "files.associations": {
    "*.blade.php": "blade",
  },

  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "notebook.formatOnCellExecution": true,
  "editor.aiStats.enabled": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "editor.wordWrap": "on",
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.enabled": false,
  "editor.useTabStops": false,
  "chat.mcp.serverSampling": {},
  "chat.mcp.gallery.enabled": true,
  "editor.tabCompletion": "on",
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "chat.commandCenter.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.tree.renderIndentGuides": "none",
  "window.newWindowProfile": "Default",
  "editor.guides.highlightActiveIndentation": "always",
  "editor.autoIndent": "keep",
  "editor.guides.indentation": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "workbench.editor.titleScrollbarVisibility": "hidden",
  "editor.lineNumbers": "off",
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.sideBar.location": "right",
  "workbench.editor.showTabs": "none",
  "explorer.confirmPasteNative": false,
  "explorer.compactFolders": false,
  "github.copilot.enable": {
    "": false,
    "*": false,
  },
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\AHMADY~1\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true,
  },
  "settingsSync.ignoredSettings": [],
  "go.delveConfig": {},
  "LaravelExtraIntellisense.modelVariables": {
    "user": "App\\Models\\User",
  },
  "files.autoSave": "afterDelay",
  "window.menuBarVisibility": "compact",
  "workbench.settings.applyToAllProfiles": [],
  "githubPullRequests.queries": [
    {
      "label": "Copilot on My Behalf",
      "query": "repo:${owner}/${repository} is:open author:copilot assignee:${user}",
    },
    {
      "label": "Local Pull Request Branches",
      "query": "default",
    },
    {
      "label": "Waiting For My Review",
      "query": "repo:${owner}/${repository} is:open review-requested:${user}",
    },
    {
      "label": "Created By Me",
      "query": "repo:${owner}/${repository} is:open author:${user}",
    },
    {
      "label": "All Open",
      "query": "default",
    },
  ],
  "editor.codeActionsOnSave": {
  
  },
}
